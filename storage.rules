rules_version = '2';

// Production rules for Ploy Spa Storage
// - Public can read all files (photos, gallery, reviews, voice intros)
// - Only authenticated admin can upload/delete
// - voice/ accepts audio (max 5 MB) — used for therapist voice intros
// - Everything else accepts images only (max 10 MB)
service firebase.storage {
  match /b/{bucket}/o {
    match /voice/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
